        "Content-Type": "multipart/form-data; boundary=x",
        "User-Agent": "Mozilla Macintosh"
       },
       "body": "--x\r\nContent-Disposition: form-data; name=\"f\"; filename=\"a.img\"\r\n\r\nx\r\n--x--\r\n",
       "expect": 403
      },
      {
       "path": "/cgi-bin/quick/quick.cgi?todo=set_timeinfo&SPECIFIC_SERVER=pool.example.com",
       "method": "GET",
       "expect": 403
      },
      {
