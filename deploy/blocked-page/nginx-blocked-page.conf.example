# jt-waf-mgr: a page for people the WAF blocked, showing the request id (optional; jt-waf-mgr never writes this).
#
# The request id is nginx's $request_id. With `modsecurity_transaction_id "$host-$request_id";` (in the http block,
# where ModSecurity is configured) the event in jt-waf-mgr carries the same id: paste it into "Someone was blocked?"
# on the Events page to open that event.
#
# 1. Copy jt-blocked.html to /usr/share/jt-waf-mgr/blocked/ (or anywhere nginx can read).
# 2. Save this file as /etc/nginx/snippets/jt-blocked-page.conf and include it in each server block that runs
#    ModSecurity:      include /etc/nginx/snippets/jt-blocked-page.conf;
# 3. nginx -t, then reload. Check: a request your WAF blocks shows the page with an id.

error_page 403 /jt-blocked.html;
location = /jt-blocked.html {
    internal;
    root /usr/share/jt-waf-mgr/blocked;
    ssi on;
    modsecurity off;
    add_header Cache-Control "no-store" always;
}
