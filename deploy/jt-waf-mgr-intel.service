[Unit]
Description=jt-waf-mgr: threat intelligence -- search the web for new vulnerabilities in the confirmed software list
Documentation=file:///usr/lib/jt-waf-mgr/README.md
After=network-online.target
Wants=network-online.target
# A short-lived job: asks the second-tier LLM (local or cloud) to search the web for new vulnerabilities in the
# software list a person confirmed (product names and versions only -- never requests, addresses or site names),
# keeps what it found, proposes virtual patches through the ordinary change workflow (checked, sandboxed; applied as
# Settings > Change workflow allows) and raises an alert for an exploited one that affects us. It
# decides itself whether [intel] interval_hours has passed; the timer only wakes it up every hour.

[Service]
# background work: below nginx and below the web interface when the host is busy
Nice=10
CPUWeight=20
IOWeight=20
Type=oneshot
User=jtwaf
Group=jtwaf
Environment=PYTHONPATH=/usr/lib/jt-waf-mgr
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 -P -m jtwafmgr --config /etc/jt-waf-mgr/config.toml intel-run
TimeoutStartSec=60min
NoNewPrivileges=yes
ProtectSystem=strict
# the database (runs, threats, audit rows) and the "search now" request file
ReadWritePaths=/var/lib/jt-waf-mgr
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
UMask=0077
# A cloud LLM, the search server and the advisories are anywhere: no address restriction here (fetch_url itself
# refuses private addresses and reads only https pages on [intel] fetch_domains). To keep a local-only setup local,
# add a drop-in (systemctl edit jt-waf-mgr-intel.service) with IPAddressDeny=any and an IPAddressAllow= list.
MemoryMax=512M
CPUQuota=50%
