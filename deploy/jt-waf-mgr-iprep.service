[Unit]
Description=jt-waf-mgr: IP reputation -- download the public IP lists, look up the outside addresses someone opened (InternetDB, MISP)
Documentation=file:///usr/lib/jt-waf-mgr/README.md
After=network-online.target
Wants=network-online.target
# The web service never connects out; only this short-lived job does (https to the list sites, Shodan InternetDB
# and the MISP the admin entered). It reads the settings from the database (the job opens it like the threat intelligence job).

[Service]
# background work: below nginx and below the web interface when the host is busy
Nice=10
CPUWeight=20
IOWeight=20
Type=oneshot
User=jtwaf
Group=jtwaf
Environment=PYTHONPATH=/usr/lib/jt-waf-mgr
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 -P -m jtwafmgr --config /etc/jt-waf-mgr/config.toml iprep-run
TimeoutStartSec=10min
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/jt-waf-mgr
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
UMask=0027
MemoryMax=256M
CPUQuota=50%
